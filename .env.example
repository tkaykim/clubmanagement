# ===========================================
# oneshotcrew.grigoent.co.kr 환경 변수 예시
# ===========================================
# 이 파일을 복사하여 .env.local 로 생성 후 값을 채워주세요.
# cp .env.example .env.local

# ----- Supabase -----
# Supabase 프로젝트 URL 및 키 (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# ----- Push Notifications (Web Push) -----
# VAPID 키 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@grigoent.co.kr

# ----- Email Notifications (Resend) -----
# Resend API 키 발급: https://resend.com/api-keys
# 도메인 인증 후 발신자 이메일 변경 가능
RESEND_API_KEY=re_xxxxxxxxxxxx

# 섭외 문의 알림 수신 이메일 (기본값: contact@grigoent.co.kr)
# 여러 명에게 보내려면 Resend 대시보드에서 팀 이메일 설정
INQUIRY_NOTIFY_EMAIL=contact@grigoent.co.kr
